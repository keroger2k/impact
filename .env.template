# IMPACT II Environment Configuration

# ── General ──────────────────────────────────────────────────────────────────
DEV_MODE=false
SESSION_TTL_HOURS=8
# Infrastructure uses self-signed certs; leave false unless you install trusted CA certs.
IMPACT_VERIFY_SSL=false
# Enables the ad-hoc SSH command runner (sidebar link + /api/commands/run).
COMMANDS_ENABLED=false
# Enables Config mode in the command runner. Pushes a multi-line config script
# to each target device over SSH (via Netmiko send_config_set). No rollback.
# Requires COMMANDS_ENABLED=true to also be set.
CONFIG_CHANGES_ENABLED=false
# Optional Config-mode caps:
# CONFIG_MAX_DEVICES=500       # hard cap per push
# CONFIG_MAX_SCRIPT_LINES=200  # hard cap on lines in a single script

# Persist sessions across server restarts. Passwords are encrypted at rest with
# Fernet (AES-128-CBC + HMAC) using SESSION_ENC_KEY. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_PERSIST=false
SESSION_ENC_KEY=

# Sets the Secure flag on the session (impact_token) and CSRF cookies, so the
# browser only returns them over HTTPS. Defaults to true (false only when
# DEV_MODE=true and this is unset). Browsers treat http://localhost as secure,
# but a remote client on plain HTTP (http://<host>:8000) will silently drop the
# cookie and bounce back to /login. Set to false ONLY on a trusted internal
# network where you can't terminate TLS — cookies then travel in cleartext.
# The right fix is to serve over HTTPS and leave this true.
IMPACT_SECURE_COOKIES=true

# ── Shared Credentials (AD) ──────────────────────────────────────────────────
DOMAIN_USERNAME=your_username
DOMAIN_PASSWORD=your_password
AD_LDAP_URL=ldap://your-domain-controller:389
AD_DOMAIN=your-domain.local

# ── Cisco Catalyst Center (DNA Center) ───────────────────────────────────────
DNA_CENTER_BASE_URL=https://your-dnac-host
DNA_CENTER_VERSION=2.3.7.6

# ── Cisco ISE ────────────────────────────────────────────────────────────────
ISE_HOST=your-ise-host

# ── Palo Alto Panorama ───────────────────────────────────────────────────────
PANORAMA_HOST=your-panorama-host

# ── F5 BIG-IP ────────────────────────────────────────────────────────────────
# No dedicated credentials: F5 reuses the logged-in user's AD creds
# (DOMAIN_USERNAME/DOMAIN_PASSWORD) over HTTP Basic Auth, so each BIG-IP must be
# configured for remote LDAP/AD auth. Access is strictly READ-ONLY (GET only).
# Device list lives in data/device_lists/f5.csv (columns: hostname,management ip address).

# ── Cisco ACI ────────────────────────────────────────────────────────────────
# Comma-separated list of fabric IDs. First entry is the default.
# Backwards compatibility: if unset but ACI_URL is set, "default" fabric is synthesized.
ACI_FABRICS=dc1,dc2,dc3

# For each ID above, define URL + domain + display label.
ACI_DC1_URL=https://apic-dc1.example.com
ACI_DC1_DOMAIN=tsa-dc1
ACI_DC1_LABEL=Dallas (DC1)

ACI_DC2_URL=https://apic-dc2.example.com
ACI_DC2_DOMAIN=tsa-dc2
ACI_DC2_LABEL=Reston (DC2)

ACI_DC3_URL=https://apic-dc3.example.com
ACI_DC3_DOMAIN=tsa-dc3
ACI_DC3_LABEL=Colorado Springs (DC3)

# DEPRECATED: use ACI_FABRICS and ACI_<ID>_URL instead.
# ACI_URL=https://your-apic-host
# ACI_DOMAIN=your-aci-domain

# ── Cache TTL overrides (seconds) ────────────────────────────────────────────
# All optional. Two tiers (see cache.py). Collection-backed data (Nexus, F5,
# IPAM tree, tunnel inventory) never expires — it lives until re-collected.
# IMPACT_TTL_STANDARD=604800          # 7d — all API-backed reads (DNAC/ISE/Panorama/ACI)
# IMPACT_TTL_LIVE=300                 # 5m — connectivity probes, cached search results
